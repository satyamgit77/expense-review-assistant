# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Allowed browser origins (comma separated). Same URL in production.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a proxy (e.g. Render) so rate limiting sees real client IPs
TRUST_PROXY=

# ---------- Database ----------
# Local:  mongodb://localhost:27017/expense_review
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense_review?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/expense_review

# ---------- Auth ----------
# Use a long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---------- AI ----------
# gemini or anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Model names change often. If you get a 404, set a currently available model.
AI_MODEL=gemini-3.5-flash-lite
# Below this confidence a classification is marked "uncertain"
AI_CONFIDENCE_THRESHOLD=0.75
AI_TIMEOUT_MS=30000

# ---------- Logging ----------
# debug | info | warn | error  (default: debug in development, info in production)
LOG_LEVEL=
# pretty | json  (default: pretty in development, json in production)
LOG_FORMAT=

# ---------- Seed scripts (npm run seed:users) ----------
SEED_REVIEWER_NAME=Reviewer One
SEED_REVIEWER_EMAIL=reviewer@example.com
# Required when seeding a remote database. The default dev password is refused there.
SEED_REVIEWER_PASSWORD=